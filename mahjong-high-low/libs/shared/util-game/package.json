{
  "name": "@hbg/shared-util-game",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts",
      "@org/source": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "tags": [
      "type:util",
      "scope:shared"
    ],
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "libs/shared/util-game/dist",
          "main": "libs/shared/util-game/src/index.ts",
          "tsConfig": "libs/shared/util-game/tsconfig.lib.json",
          "format": [
            "esm"
          ],
          "declarationRootDir": "libs/shared/util-game/src"
        }
      },
      "test": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "options": {
          "jestConfig": "libs/shared/util-game/jest.config.cts"
        }
      }
    }
  },
  "dependencies": {}
}
