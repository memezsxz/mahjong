{
  "compilerOptions": {
    "baseUrl": ".",
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "paths": {
      "@hbg/shared-models": ["libs/shared/models/src/index.ts"],
      "@hbg/shared-util-game": ["libs/shared/util-game/src/index.ts"],
      "@hbg/api-leaderboard": ["libs/api/leaderboard/src/index.ts"],
      "@hbg/game-data-access": ["libs/game/data-access/src/index.ts"],
      "@hbg/game-feature": ["libs/game/feature/src/index.ts"],
      "@hbg/game-ui": ["libs/game/ui/src/index.ts"]
    }
  }
}
